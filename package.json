{
  "name": "siris-base",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "vitest run",
    "dev": "node dev.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.js.json",
    "test:e2e": "playwright test",
    "format": "prettier --write \"**/*.{mjs,js,ts,css,html}\"",
    "format:check": "prettier --check \"**/*.{mjs,js,ts,css,html}\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "22.18.6",
    "eslint": "9.36.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
