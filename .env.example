# Sao chép thành .env.local và điền cấu hình môi trường cần dùng.
SUPABASE_URL=
SUPABASE_KEY=
# Tùy chọn: kết nối PostgreSQL server-side cho discovery; không đưa lên trình duyệt.
SUPABASE_DB_URL=
# Các tài khoản được phép quản trị, ngăn cách bằng dấu phẩy (sẽ dùng từ Phase 4).
SIRIS_ADMIN_USER_IDS=
