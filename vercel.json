{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["icn1"],
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/handler.mjs": {
      "includeFiles": "{dist/**,schema.json}",
      "maxDuration": 60
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/handler" }]
}
